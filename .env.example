# ==============================================================================
# AI Data Governor — Environment Variables Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase / PostgreSQL Database Connection (Task 0.2 & Phase 1)
# ------------------------------------------------------------------------------
# Direct Postgres connection credentials obtained from Supabase project settings
# (Settings -> Database -> Connection string -> Direct connection)
POSTGRES_HOST=db.xxxxxxxxxxxxxxxxxxxx.supabase.co
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_supabase_database_password
POSTGRES_SSL=true

# Alternative single connection URI:
DATABASE_URL=postgresql://postgres:your_supabase_database_password@db.xxxxxxxxxxxxxxxxxxxx.supabase.co:5432/postgres?sslmode=require

# ------------------------------------------------------------------------------
# 2. AI Model API Keys (Task 0.3)
# ------------------------------------------------------------------------------
# Groq Cloud API key for Master Data Investigator Agent (Groq / Kimi K2)
# Obtain from: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# Google Gemini API key for Fixer Agent & Reporter Agent (Gemini 2.5 Flash)
# Obtain from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzayour_gemini_api_key_here

# ------------------------------------------------------------------------------
# 3. Google Cloud OAuth2 Configuration (Task 0.4)
# ------------------------------------------------------------------------------
# For Gmail approval gates, Google Docs report creation, and Google Drive sharing
# OAuth Callback URL for n8n: http://localhost:5678/rest/oauth2-credential/callback
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret

# ------------------------------------------------------------------------------
# 4. Operator & Approver Settings (Phase 4 & 7)
# ------------------------------------------------------------------------------
OPERATOR_EMAIL=operator@example.com
APPROVER_EMAIL=approver@example.com

# ------------------------------------------------------------------------------
# 5. n8n Configuration
# ------------------------------------------------------------------------------
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_HOST=localhost
WEBHOOK_URL=http://localhost:5678/
